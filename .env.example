# =============================================================================
# 影策 · 环境变量配置模板
# 复制为 .env 并按需修改；不要在 .env.example 中填写任何密钥。
# =============================================================================

# ── 端口配置 ─────────────────────────────────────────────
# 前端 Web 端口
CANVAS_HTTP_PORT=3000
# 后端 API 端口
CANVAS_BACKEND_HOST_PORT=8080
# PostgreSQL 端口
POSTGRES_HOST_PORT=5432
# Redis 端口
REDIS_HOST_PORT=6379

# ── 数据持久化路径 ───────────────────────────────────────
# 后端上传文件存储目录
CANVAS_DATA_PATH=./data/backend
# PostgreSQL 数据目录
CANVAS_POSTGRES_DATA_PATH=./data/postgres
# Redis 数据目录
CANVAS_REDIS_DATA_PATH=./data/redis

# ── 数据库配置 ───────────────────────────────────────────
# 新服务器请直接运行 README 的一键部署命令；脚本会在 .env 中生成随机密码。
POSTGRES_DB=open_ai_canvas
POSTGRES_USER=open_ai_canvas
POSTGRES_PASSWORD=由部署脚本随机生成
DATABASE_URL=postgresql://open_ai_canvas:随机密码@postgres:5432/open_ai_canvas?sslmode=disable
REDIS_URL=redis://redis:6379/0

# ── 应用运行配置 ─────────────────────────────────────────
# CORS 来源，多个使用英文逗号分隔
CANVAS_CORS_ORIGINS=http://localhost:3000
# 是否开放注册（第一个注册的账号自动成为管理员）
CANVAS_REGISTRATION_ENABLED=false
# 异步任务 Worker 并发数
CANVAS_WORKER_CONCURRENCY=3
# 渠道并发数
CANVAS_CHANNEL_CONCURRENCY=3

# ── 网络安全 ─────────────────────────────────────────────
# 默认拒绝后端访问本机和私网；可信私网或 HTTP 服务按主机精确放行
CANVAS_ALLOW_PRIVATE_UPSTREAMS=false
# 多个主机使用英文逗号分隔，例如：gateway.internal,192.168.1.10
# 不要填写协议、端口或路径
CANVAS_ALLOWED_PRIVATE_UPSTREAM_HOSTS=

# ── 桌面部署（可选）──────────────────────────────────────
# “允许本机渠道”是独立的桌面部署能力，默认关闭
# 只有后端实际绑定 127.0.0.1 时 true 才会生效
CANVAS_DESKTOP_LOCAL_CHANNELS_ENABLED=false
# 启用本机渠道时必须显式指定：CANVAS_BACKEND_ADDR=127.0.0.1:8080

# ── 运行时 UID/GID（可选）───────────────────────────────
# 与宿主机用户保持一致，避免 bind-mount 文件权限问题
# LOCAL_UID=1000
# LOCAL_GID=1000
